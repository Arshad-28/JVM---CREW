# ==============================================================================
# EngineerSpace — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and populate with your environment-specific credentials.
# NEVER commit actual secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER / BACKEND CONFIGURATION (Spring Boot)
# ------------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Connection (PostgreSQL / Supabase)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/jvmcrew_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password

# JWT Authentication
# Must be a secure 256-bit+ secret key
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long_for_hs256_security
JWT_EXPIRATION_MS=86400000

# Supabase Storage Configuration (Standup Audio & Uploads)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=jvmcrew-files

# Local Storage Fallback Directory
STORAGE_LOCAL_DIR=uploads

# AI Providers (Interview Lab & AI Coach)
GEMINI_API_KEY=your_google_gemini_api_key
OPENAI_API_KEY=your_optional_openai_fallback_api_key

# Web Push Notifications (VAPID Keys)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@engineerspace.app

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://engineerspace.netlify.app

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ------------------------------------------------------------------------------
# 2. CLIENT / FRONTEND CONFIGURATION (React / Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key\n
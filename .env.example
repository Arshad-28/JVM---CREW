# JVM CREW - Environment Configuration Example
# Copy this file to .env or pass environment variables to docker compose

# AI Provider Configuration (Google Gemini, backend only - never exposed to frontend)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash

# Database Configuration
POSTGRES_DB=jvmcrew
POSTGRES_USER=jvmcrew
POSTGRES_PASSWORD=jvmcrew_password

# JWT Secret
JWT_SECRET=your secrete key here

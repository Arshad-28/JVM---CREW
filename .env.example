# =============================================================================
# JVM CREW — Environment Variables Template
# Copy this file to .env for local development or enter these in your hosting providers.
# DO NOT commit real secrets (.env) to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. LOCAL DEVELOPMENT (Docker Compose)
# -----------------------------------------------------------------------------
POSTGRES_DB=jvmcrew
POSTGRES_USER=jvmcrew
POSTGRES_PASSWORD=jvmcrew_password
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
APP_AUDIO_UPLOAD_DIR=/app/uploads/audio

# -----------------------------------------------------------------------------
# 2. AI INTERVIEW LAB & MOCK SESSIONS (Backend Only — Never exposed to frontend)
# -----------------------------------------------------------------------------
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.6-flash
AI_BASE_URL=
AI_TIMEOUT_SECONDS=60

# -----------------------------------------------------------------------------
# 3. PRODUCTION BACKEND (Render Web Service)
# -----------------------------------------------------------------------------
# Server port (assigned automatically by Render in production)
PORT=8080
SERVER_ADDRESS=0.0.0.0

# Supabase PostgreSQL connection
# (Use Session Pooler connection string for best IPv4/IPv6 compatibility)
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.<your-project-ref>
SPRING_DATASOURCE_PASSWORD=your_supabase_db_password_here
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_FLYWAY_ENABLED=true

# Allowed CORS Origins (Set to your Netlify public domain)
CORS_ALLOWED_ORIGINS=https://<your-app-name>.netlify.app,http://localhost:3000

# Supabase Persistent Storage for Voice Standups & Files
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
SUPABASE_STORAGE_BUCKET=jvmcrew-audio

# -----------------------------------------------------------------------------
# 4. PRODUCTION FRONTEND (Netlify Build Environment)
# -----------------------------------------------------------------------------
# Set if calling Render backend directly across domains (optional if using Netlify proxy)
VITE_API_BASE_URL=https://<your-render-backend-name>.onrender.com/api
